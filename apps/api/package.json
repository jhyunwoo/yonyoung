{
  "name": "@yonyoung/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --check .",
    "db:migrate": "pnpm wrangler d1 execute yonyoung-db --local --file ../../packages/db/sql/0001_init.sql"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.2.1",
    "@hono/zod-validator": "^0.7.5",
    "@yonyoung/auth": "workspace:*",
    "@yonyoung/db": "workspace:*",
    "@yonyoung/schemas": "workspace:*",
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260204.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.65.0"
  }
}
