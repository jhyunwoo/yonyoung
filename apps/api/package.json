{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "pnpm run db:migrate && wrangler dev",
    "deploy": "pnpm run db:migrate:remote && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/tests/worker.runtime.integration.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generation": "drizzle-kit generate",
    "db:backfill:rich-text": "node scripts/backfill-rich-text-html.mjs",
    "db:migrate": "wrangler d1 migrations apply yonyoung-db --remote",
    "db:migrate:remote": "pnpm run db:migrate",
    "db:push": "drizzle-kit generate && wrangler d1 migrations apply yonyoung-db --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.998.0",
    "@aws-sdk/s3-request-presigner": "^3.998.0",
    "@hono/zod-openapi": "^1.2.2",
    "@repo/shared-api-contracts": "workspace:*",
    "@repo/shared-auth": "workspace:*",
    "@scalar/hono-api-reference": "^0.9.45",
    "better-auth": "^1.4.19",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.2",
    "xss": "^1.0.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^25.3.1",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.68.1"
  }
}
