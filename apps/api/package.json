{
  "name": "@yonyoung/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run db:migrate:local && wrangler dev --env dev",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy --env=\"\" --minify",
    "deploy:dry-run": "wrangler deploy --env=\"\" --dry-run --outdir .wrangler/dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply yonyoung-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply yonyoung-db --remote",
    "db:studio": "drizzle-kit studio",
    "backfill:image-dimensions": "node scripts/backfill-image-dimensions.mjs",
    "check-types": "pnpm run typecheck",
    "clean:dry-run": "node scripts/clean-generated-dry-run.mjs",
    "test:node": "vitest run",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "test:unit": "vitest run",
    "test": "pnpm run test:node && pnpm run test:workers",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "pnpm run clean:dry-run && vitest run --coverage",
    "security:audit": "node ../../tooling/audit-api-production.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@aws-sdk/s3-request-presigner": "3.1121.0",
    "@hono/zod-openapi": "1.6.1",
    "@scalar/hono-api-reference": "0.12.0",
    "@sentry/cloudflare": "10.75.2",
    "@yonyoung/contracts": "workspace:*",
    "better-auth": "1.7.2",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "xss": "1.0.15",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "@yonyoung/eslint-config": "workspace:*",
    "@yonyoung/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "wrangler": "^4.138.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
