/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "placement": {
    "mode": "smart",
  },
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "yonyoung-db",
      "database_id": "2b8373ca-0dd5-486f-aa2f-4847e5e2b79a",
      "migrations_dir": "drizzle",
      "remote": false,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://api.yonyoung.moveto.kr",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://yonyoung.moveto.kr",
    "R2_PUBLIC_BASE_URL": "https://storage.yonyoung.moveto.kr",
    "CSP_REPORT_ONLY": "true",
    "D1_SESSION_CONSISTENCY": "off",
    "D1_WRITE_RETRY_ENABLED": "true",
    "D1_WRITE_RETRY_MAX_RETRIES": "2",
    "D1_WRITE_RETRY_BASE_DELAY_MS": "25",
    "D1_WRITE_RETRY_MAX_DELAY_MS": "500",
  },
  "env": {
    "staging": {
      "name": "api-staging",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.3,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 0.3,
          "persist": true,
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.3,
          "persist": true,
        },
      },
      "vars": {
        "BETTER_AUTH_URL": "https://api-staging.yonyoung.moveto.kr",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://staging.yonyoung.moveto.kr",
        "R2_PUBLIC_BASE_URL": "https://storage-staging.yonyoung.moveto.kr",
        "CSP_REPORT_ONLY": "true",
        "D1_SESSION_CONSISTENCY": "first-unconstrained",
        "D1_WRITE_RETRY_ENABLED": "true",
        "D1_WRITE_RETRY_MAX_RETRIES": "2",
        "D1_WRITE_RETRY_BASE_DELAY_MS": "25",
        "D1_WRITE_RETRY_MAX_DELAY_MS": "500",
      },
    },
    "production": {
      "name": "api",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
        },
      },
      "vars": {
        "BETTER_AUTH_URL": "https://api.yonyoung.moveto.kr",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://yonyoung.moveto.kr",
        "R2_PUBLIC_BASE_URL": "https://storage.yonyoung.moveto.kr",
        "CSP_REPORT_ONLY": "false",
        "D1_SESSION_CONSISTENCY": "first-primary",
        "D1_WRITE_RETRY_ENABLED": "true",
        "D1_WRITE_RETRY_MAX_RETRIES": "2",
        "D1_WRITE_RETRY_BASE_DELAY_MS": "25",
        "D1_WRITE_RETRY_MAX_DELAY_MS": "500",
      },
    },
  },
  "r2_buckets": [
    {
      "bucket_name": "yonyoung-storage",
      "binding": "r2",
      "remote": false,
    },
  ],
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
