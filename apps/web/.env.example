# 서버에서 호출할 yonyoung-api 주소입니다. 끝의 슬래시는 자동으로 제거됩니다.
API_BASE_URL=https://api.yonyoung.moveto.kr

# 브라우저에 노출되는 웹사이트의 공개 origin입니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 선택 사항: R2 미디어를 Cloudflare Image Transformations로 전송할 공개 origin입니다.
NEXT_PUBLIC_IMAGE_CDN_BASE_URL=https://storage.yonyoung.moveto.kr
