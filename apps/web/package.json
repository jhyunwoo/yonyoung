    "@uppy/aws-s3": "6.0.0",
    "@uppy/core": "6.0.0",
    "@yonyoung/contracts": "workspace:*",
    "better-auth": "1.7.2",
    "framer-motion": "13.1.1",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
