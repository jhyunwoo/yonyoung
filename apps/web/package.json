{
  "name": "@yonyoung/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && node ./node_modules/typescript7/lib/tsc.js -p tsconfig.typecheck.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fonts:sync": "node scripts/sync-pretendard.mjs",
    "fonts:check": "node scripts/sync-pretendard.mjs --check",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "./scripts/run-playwright.sh test tests/e2e/home.spec.ts tests/e2e/dashboard-auth.spec.ts --grep \"home renders and contains main text|unauthenticated dashboard access is redirected or forbidden\"",
    "test:e2e:full": "./scripts/run-playwright.sh test",
    "test:e2e:full:repeat": "./scripts/run-playwright.sh test --repeat-each=2",
    "test": "pnpm test:unit && pnpm test:e2e:full",
    "test:ci": "pnpm fonts:check && pnpm lint && pnpm typecheck && pnpm test:unit:coverage && pnpm test:e2e:full"
  },
