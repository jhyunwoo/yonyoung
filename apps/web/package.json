{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "E2E_SUITE_MODE=smoke playwright test",
    "test:e2e:smoke": "E2E_SUITE_MODE=smoke playwright test",
    "test:e2e:full": "E2E_SUITE_MODE=full E2E_ROLE_MATRIX=all playwright test",
    "test:e2e:headed": "E2E_SUITE_MODE=smoke playwright test --headed",
    "perf:budget": "node ../../scripts/perf-budget.mjs",
    "perf:lighthouse": "node ../../scripts/lighthouse-runner.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.16.5",
    "@repo/shared-api-contracts": "workspace:*",
    "@repo/shared-auth": "workspace:*",
    "@repo/shared-http": "workspace:*",
    "@uppy/core": "^5.2.0",
    "better-auth": "^1.4.18",
    "framer-motion": "^12.34.2",
    "lucide-react": "^0.575.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.67.0"
  }
}
