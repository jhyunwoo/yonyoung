{
  "name": "@yonyoung/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/api-contracts.ts",
    "./schemas": "./src/api-schemas.ts",
    "./auth-profile": "./src/auth-profile.ts",
    "./auth-roles": "./src/auth-roles.ts",
    "./activities": "./src/api/activities.ts",
    "./attachments": "./src/api/attachments.ts",
    "./audit": "./src/api/audit.ts",
    "./common": "./src/api/common.ts",
    "./dashboard": "./src/api/dashboard.ts",
    "./exhibitions": "./src/api/exhibitions.ts",
    "./generations": "./src/api/generations.ts",
    "./linktree": "./src/api/linktree.ts",
    "./recruiting": "./src/api/recruiting.ts",
    "./site-settings": "./src/api/site-settings.ts",
    "./uploads": "./src/api/uploads.ts",
    "./users": "./src/api/users.ts"
  },
  "scripts": {
    "build": "node ./node_modules/typescript7/lib/tsc.js --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "node ./node_modules/typescript7/lib/tsc.js --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "@yonyoung/eslint-config": "workspace:*",
    "@yonyoung/typescript-config": "workspace:*",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.2"
  }
}
