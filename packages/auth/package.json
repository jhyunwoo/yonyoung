{
  "name": "@yonyoung/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "echo 'No tests for auth package'",
    "format": "prettier --check ."
  },
  "dependencies": {
    "better-auth": "^1.4.18",
    "@better-auth/passkey": "^1.2.4",
    "@yonyoung/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260204.0",
    "@types/node": "^20.19.33"
  }
}
