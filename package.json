{
  "name": "@yonyoung/monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:ci": "node tooling/run-with-web-mock-api.mjs pnpm turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@yonyoung/web",
    "dev:api": "turbo run dev --filter=@yonyoung/api",
    "start:web": "turbo run start --filter=@yonyoung/web",
    "lint": "pnpm boundaries && turbo run lint",
    "boundaries": "node tooling/check-boundaries.mjs",
    "format": "turbo run format && prettier --write . --ignore-unknown",
    "format:check": "turbo run format:check && prettier --check . --ignore-unknown",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:full": "turbo run test:e2e:full",
    "test:e2e:full:repeat": "turbo run test:e2e:full:repeat",
    "cf-typegen": "turbo run cf-typegen --filter=@yonyoung/api",
    "deploy:dry-run": "turbo run deploy:dry-run",
    "deploy:web:build": "turbo run build --filter=@yonyoung/web...",
    "deploy:api": "turbo run deploy --filter=@yonyoung/api",
    "db:generate": "turbo run db:generate --filter=@yonyoung/api",
    "db:migrate:local": "turbo run db:migrate:local --filter=@yonyoung/api",
    "db:migrate:remote": "turbo run db:migrate:remote --filter=@yonyoung/api",
    "security:audit": "turbo run security:audit",
    "fonts:check": "turbo run fonts:check --filter=@yonyoung/web",
    "fonts:sync": "turbo run fonts:sync --filter=@yonyoung/web",
    "test:workers": "turbo run test:workers",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:workers && pnpm test:coverage && pnpm build",
    "turbo:ls": "turbo ls",
    "turbo:affected": "turbo ls --affected"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.8.12"
  },
  "engines": {
    "node": ">=22.13 <23"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
